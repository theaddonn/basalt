# LLVM base with Linux-style function braces and a few modern extras.
# Requires clang-format 17+ (CI pins 20.1.8).
BasedOnStyle: LLVM
Standard: c++20
IndentWidth: 4
# keep public:/private: flush with the class keyword
AccessModifierOffset: -4
ColumnLimit: 80

# int *p, like LLVM, Linux and GNU
PointerAlignment: Right
ReferenceAlignment: Pointer

# Linux: function bodies open on their own line, everything else attached
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
RequiresClausePosition: OwnLine
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never
IndentCaseLabels: false
FixNamespaceComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Always

# always brace control statements, tidy up stray semicolons
InsertBraces: true
RemoveSemicolon: true
InsertNewlineAtEOF: true

# includes: own headers, then third-party, then the standard library
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"basalt/'
    Priority: 1
  - Regex: '^<[a-z_]+>$'
    Priority: 3
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '.*'
    Priority: 1
