    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "theaddonn"
            VALUE "FileDescription", "basalt - a C++ rewrite of Regolith"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "basalt"
            VALUE "OriginalFilename", "basalt.exe"
            VALUE "ProductName", "basalt"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
